# URL of the Rust API, only used server-side by Next.js.
API_URL=http://127.0.0.1:8080
DOMAIN_URL=https://xetaravel.com

# Public Cloudflare Turnstile site key of the login/register forms (mandatory:
# `next dev` / `next build` refuse to start without it). It is inlined by
# `next build`: it must be set at build time.
# Development and e2e use the Cloudflare test site key below (always passes,
# paired with the test secret 1x0000000000000000000000000000000AA of the API);
# set the real site key in production. To simulate a failure, pair it with the
# API test secret 2x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
