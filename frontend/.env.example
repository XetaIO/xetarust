# URL of the Rust API, only used server-side by Next.js.
API_URL=http://127.0.0.1:8080

# Public Cloudflare Turnstile site key of the login/register forms. It is
# inlined by `next build`: it must be set at build time. Leave empty to disable
# the captcha (dev, e2e), together with TURNSTILE_SECRET on the API side.
# Test keys: site 1x00000000000000000000AA with secret
# 1x0000000000000000000000000000000AA (always passes) or
# 2x0000000000000000000000000000000AA (always fails).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
