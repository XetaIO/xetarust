# --- Backend (Rust API) ---
DATABASE_URL=postgres://xetaravel:xetaravel@localhost:5442/xetaravel
# Used by the persistence and HTTP integration tests (see docker-compose `postgres_test`).
DATABASE_URL_TEST=postgres://xetaravel:xetaravel@localhost:5443/xetaravel_test
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret
# JWT lifetime in seconds (7 days).
JWT_TTL_SECONDS=604800
# Keep the API bound to loopback: only the Next.js server may reach it, since
# the client IP (rate limit, captcha) is read from its X-Forwarded-For header.
APP_ADDR=127.0.0.1:8080
CORS_ORIGIN=http://localhost:3000
# Directory of the uploaded files (article cover images), relative to the working directory.
UPLOADS_DIR=storage/uploads
# Cloudflare Turnstile secret key of login/register (mandatory: the API refuses
# to start without it). Development and e2e use the Cloudflare test secret below
# (always passes, with the test site key 1x00000000000000000000AA of the
# frontend); set the real secret in production. To simulate a failure, use the
# test secret 2x0000000000000000000000000000000AA.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Per-IP rate limit of login/register: AUTH_RATE_LIMIT_BURST attempts in a row,
# then one more every AUTH_RATE_LIMIT_PERIOD_SECONDS (defaults: 5 and 12 = 5/min).
AUTH_RATE_LIMIT_BURST=5
AUTH_RATE_LIMIT_PERIOD_SECONDS=12
RUST_LOG=xetaravel_app=debug,xetaravel_kernel=debug,tower_http=info
